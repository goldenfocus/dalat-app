{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalat-app",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Required: unminified the bundle exceeds the 10MB Workers gzip cap
  "minify": true,
  // ⛔ NO "routes" HERE — dalat.app is served by VERCEL (git push auto-deploys).
  // Worker routes were re-added by `wrangler deploy` and broke prod THREE times
  // (Jul 17, Jul 22, Aug 1 2026): the worker bundle bakes in stale env keys and
  // its @aws-sdk presign path cannot run in workerd, killing all uploads.
  // Do not re-add routes until r2.ts is workerd-compatible (aws4fetch) AND an
  // authenticated presign probe returns 200 through a routeless worker preview.
  // Cloudflare Images binding — lets the OpenNext image handler actually
  // resize/compress next/image requests (otherwise originals pass through)
  "images": {
    "binding": "IMAGES"
  },
  // Next SSR + AI-backed cron routes need headroom beyond the 30s default
  "limits": {
    "cpu_ms": 300000
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "dalat-app-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "dalat-app-tags",
      "database_id": "4a1a4547-81f5-45d6-99f1-65222b790d31"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  // Mirrors vercel.json crons; cloudflare/worker.ts maps expression -> path.
  // Fresh news discovery runs every two hours; processing follows 30 minutes
  // later so a source page has time to settle before extraction.
  "triggers": {
    "crons": [
      "0 20 * * *",
      "0 1 * * *",
      "0 3 * * *",
      "0 16 * * *",
      "5 */2 * * *",
      "35 */2 * * *",
      "*/5 * * * *",
      "30 20 * * *",
      "7 * * * *",
      "30 2 * * *",
      "15 */4 * * *"
    ]
  }
}
