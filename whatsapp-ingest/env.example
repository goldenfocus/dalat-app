# Copy values from the app .env.local / vault. Never commit real keys.
# The service also reads ../.env.local automatically (DOTENV_PATH override).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Profile UUID that owns WhatsApp drafts (defaults to username "yan")
IMPORT_CREATED_BY=

# Comma-separated allowlist. Empty = discovery mode (log JIDs, ingest nothing).
# Collect JIDs from discovery logs: they look like 120363012345678901@g.us
WHATSAPP_GROUP_JIDS=120363000000000000@g.us,120363000000000001@g.us

# Optional notify after a successful draft upsert. Review can also poll
# events where source_metadata.needs_review = true AND status = draft.
# Do not point this at POST /api/import/review — that route evaluates/publishes.
REVIEW_HOOK_URL=
REVIEW_INGEST_KEY=
