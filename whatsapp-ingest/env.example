# Copy values from the app .env.local / vault. Never commit real keys.
# The service also reads ../.env.local automatically (DOTENV_PATH override).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Profile UUID that owns WhatsApp drafts (defaults to username "yan")
IMPORT_CREATED_BY=

# Comma-separated allowlist. Empty = discovery mode (log JIDs, ingest nothing).
# Collect JIDs from discovery logs: they look like 120363012345678901@g.us
WHATSAPP_GROUP_JIDS=120363000000000000@g.us,120363000000000001@g.us

# Optional notify after a successful draft upsert. Review can also poll
# events where source_metadata.needs_review = true AND status = draft.
# Do not point this at POST /api/import/review — that route evaluates/publishes.
# Nothing in this repo polls that queue; Dalat Review has to call it.
REVIEW_HOOK_URL=
REVIEW_INGEST_KEY=

# Flyer heroes upload to the same R2 bucket Scout uses
# (event-media/{slug}/{timestamp}.ext on cdn.dalat.app).
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.dalat.app
CLOUDFLARE_R2_BUCKET_NAME=dalat-app-media

# Flyer vision and announcement reading. Uses keys the app already has.
# Leave the model blank to keep gpt-4.1-mini / Claude Sonnet / Gemini Flash Lite.
# WHATSAPP_EVENT_LLM=off skips the model (text dates still parse).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
WHATSAPP_EVENT_MODEL=
WHATSAPP_EVENT_LLM=
